{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "noir", "name": "Noir", "color": "#070707" },
				{ "slug": "noir-2", "name": "Noir carte", "color": "#111111" },
				{ "slug": "noir-3", "name": "Noir vignette", "color": "#1b1b1b" },
				{ "slug": "trait", "name": "Filet", "color": "#2a2a2a" },
				{ "slug": "blanc", "name": "Blanc", "color": "#ffffff" },
				{ "slug": "gris", "name": "Gris", "color": "#b4b4b4" },
				{ "slug": "gris-2", "name": "Gris discret", "color": "#8a8a8a" },
				{ "slug": "safran", "name": "Safran", "color": "#f4a91f" },
				{ "slug": "succes", "name": "Succès", "color": "#4cc38a" },
				{ "slug": "erreur", "name": "Erreur", "color": "#ff7a6b" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1440px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "rem", "em", "%", "vh", "vw"],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.875rem" },
				{ "slug": "30", "name": "3", "size": "1.375rem" },
				{ "slug": "40", "name": "4", "size": "clamp(1.5rem, 1rem + 2vw, 2.5rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(2.25rem, 1.5rem + 3vw, 3.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3rem, 2rem + 4vw, 5.5rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(4.5rem, 2rem + 7vw, 8.75rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "hanken-grotesk",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-italic-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-italic-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "anton",
					"name": "Anton (affiche)",
					"fontFamily": "Anton, Impact, \"Arial Narrow\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Anton",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/anton/anton-latin.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "legende", "name": "Légende", "size": "0.8125rem" },
				{ "slug": "secondaire", "name": "Secondaire", "size": "0.9375rem" },
				{ "slug": "corps", "name": "Corps", "size": "1.0625rem" },
				{ "slug": "chapo", "name": "Chapô", "size": "clamp(1.0625rem, 0.95rem + 0.45vw, 1.3125rem)" },
				{ "slug": "sous-titre", "name": "Sous-titre", "size": "clamp(1.3125rem, 1.05rem + 0.9vw, 1.75rem)" },
				{ "slug": "titre", "name": "Titre", "size": "clamp(1.625rem, 1.1rem + 1.8vw, 2.75rem)" },
				{ "slug": "affiche", "name": "Affiche", "size": "clamp(2.75rem, 1.2rem + 5.2vw, 6.5rem)" },
				{ "slug": "affiche-xl", "name": "Affiche XL", "size": "clamp(4.75rem, 1.5rem + 9.6vw, 10.75rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"border": {
			"radius": true,
			"radiusSizes": [
				{ "slug": "vignette", "name": "Vignette", "size": "6px" },
				{ "slug": "carte", "name": "Carte", "size": "14px" },
				{ "slug": "pilule", "name": "Pilule", "size": "999px" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|noir",
			"text": "var:preset|color|blanc"
		},
		"spacing": {
			"blockGap": "1.375rem",
			"padding": {
				"left": "clamp(16px, 4vw, 64px)",
				"right": "clamp(16px, 4vw, 64px)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|hanken-grotesk",
			"fontSize": "var:preset|font-size|corps",
			"lineHeight": "1.55",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|safran" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|anton",
					"fontSize": "var:preset|font-size|affiche",
					"fontWeight": "400",
					"letterSpacing": "0.005em",
					"lineHeight": "1.12",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|titre" }
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|sous-titre",
					"lineHeight": "1.15"
				}
			},
			"h4": {
				"typography": { "fontSize": "var:preset|font-size|corps" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|safran",
					"text": "var:preset|color|noir"
				},
				"border": {
					"radius": "999px",
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"bottom": "0.95rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "#ffbb3a",
						"text": "var:preset|color|noir"
					}
				},
				":focus": {
					"color": {
						"background": "#ffbb3a",
						"text": "var:preset|color|noir"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|gris" },
				"typography": { "fontSize": "var:preset|font-size|legende" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|secondaire",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.875rem",
					"fontWeight": "800",
					"letterSpacing": "-0.04em",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var:preset|color|blanc" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|gris" },
				"typography": { "fontSize": "var:preset|font-size|secondaire" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|secondaire" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|trait" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|safran",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": { "left": "1.25rem" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|sous-titre",
					"lineHeight": "1.4"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-sans-titre",
			"title": "Page pleine largeur sans titre",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}

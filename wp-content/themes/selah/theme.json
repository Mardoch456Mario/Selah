{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "encre", "name": "Encre", "color": "#0b0b0c" },
				{ "slug": "blanc", "name": "Blanc", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f3f3f2" },
				{ "slug": "trait", "name": "Trait", "color": "#e4e4e2" },
				{ "slug": "discret", "name": "Discret", "color": "#6b6b70" },
				{ "slug": "safran", "name": "Safran", "color": "#c9922a" },
				{ "slug": "succes", "name": "Succès", "color": "#1f7a4d" },
				{ "slug": "erreur", "name": "Erreur", "color": "#b3261e" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "rem", "em", "%", "vh", "vw"],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1.25rem" },
				{ "slug": "40", "name": "4", "size": "clamp(1.5rem, 1.2rem + 1vw, 2rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3rem, 2rem + 4vw, 5rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(4rem, 2.5rem + 6vw, 8rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "hanken-grotesk",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-italic-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/hanken-grotesk/hanken-grotesk-italic-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "legende", "name": "Légende", "size": "0.75rem" },
				{ "slug": "secondaire", "name": "Secondaire", "size": "0.875rem" },
				{ "slug": "corps", "name": "Corps", "size": "1rem" },
				{ "slug": "sous-titre", "name": "Sous-titre", "size": "1.25rem" },
				{ "slug": "titre", "name": "Titre", "size": "clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem)" },
				{ "slug": "grand-titre", "name": "Grand titre", "size": "clamp(2.25rem, 1.4rem + 3.6vw, 4rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "douce", "name": "Douce", "shadow": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)" }
			]
		},
		"border": {
			"radius": true,
			"radiusSizes": [
				{ "slug": "carte", "name": "Carte", "size": "1.25rem" },
				{ "slug": "pilule", "name": "Pilule", "size": "999px" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|blanc",
			"text": "var:preset|color|encre"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "1.5rem",
				"right": "1.5rem"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|hanken-grotesk",
			"fontSize": "var:preset|font-size|corps",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|grand-titre",
					"fontWeight": "800",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|titre" }
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|sous-titre",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": { "fontSize": "var:preset|font-size|corps" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|encre",
					"text": "var:preset|color|blanc"
				},
				"border": {
					"radius": "999px",
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|encre"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|corps",
					"fontWeight": "600",
					"lineHeight": "1.5",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "#0b0b0cd9",
						"text": "var:preset|color|blanc"
					}
				},
				":focus": {
					"color": {
						"background": "#0b0b0cd9",
						"text": "var:preset|color|blanc"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|discret" },
				"typography": { "fontSize": "var:preset|font-size|legende" }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "currentColor"
						},
						"border": {
							"color": "currentColor",
							"width": "1px",
							"style": "solid"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|secondaire",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.75rem",
					"fontWeight": "800",
					"letterSpacing": "-0.025em"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|discret" },
				"typography": { "fontSize": "var:preset|font-size|secondaire" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|secondaire" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|trait" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|safran",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": { "left": "1.25rem" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|sous-titre",
					"lineHeight": "1.4"
				}
			},
			"core/search": {
				"border": { "radius": "999px" }
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-sans-titre",
			"title": "Page pleine largeur sans titre",
			"postTypes": ["page"]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
